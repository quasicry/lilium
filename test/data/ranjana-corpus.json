 "sentences": [
  [
   "anirodham anutpādam anucchedam aśāśvatam .",
   "अनिरोधम् अनुत्पादम् अनुच्छेदम् अशाश्वतम् ।"
  ],
  [
   "anekārtham anānārtham anāgamam anirgamam ..",
   "अनेकार्थम् अनानार्थम् अनागमम् अनिर्गमम् ॥"
  ],
  [
   "yaḥ pratītyasamutpādaṃ prapañcopaśamaṃ śivam .",
   "यः प्रतीत्यसमुत्पादं प्रपञ्चोपशमं शिवम् ।"
  ],
  [
   "deśayāmāsa saṃbuddhastaṃ vande vadatāṃ varam ..",
   "देशयामास संबुद्धस्तं वन्दे वदतां वरम् ॥"
  ],
  [
   "ye dhammā hetuppabhavā tesaṃ hetuṃ tathāgato āha .",
   "ये धम्मा हेतुप्पभवा तेसं हेतुं तथागतो आह ।"
  ],
  [
   "tesañca yo nirodho evaṃ vādī mahāsamaṇo ..",
   "तेसञ्च यो निरोधो एवं वादी महासमणो ॥"
  ]
 ]
