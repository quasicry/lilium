{
  "name": "lilium",
  "version": "0.3.5",
  "description": "Lilium — universal dictionary & transliteration for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node test/run.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "audit": "node test/ui-audit.mjs",
    "preview": "node test/ui-preview.mjs",
    "lint": "eslint 'src/**/*.ts'",
    "lint:ci": "eslint 'src/**/*.ts' --max-warnings 64",
    "test:hardening": "node test/hardening.mjs",
    "test:dict-import": "node test/dict-import.mjs",
    "test:dict-import-flow": "node test/dict-import-flow.mjs",
    "deliver": "node scripts/deliver.mjs",
    "verify:writeback": "node scripts/verify-writeback.mjs",
    "test:vanchor": "node test/vertical-anchor.mjs",
    "test:vanchor:browser": "node test/vertical-anchor-browser.mjs",
    "test:interaction": "node test/interaction.mjs",
    "test:brahmic": "node test/brahmic.mjs",
    "test:corpus": "node test/buddhist-corpus.mjs",
    "test:classical": "node test/classical-corpus.mjs",
    "test:allschemes": "node test/all-schemes-corpus.mjs",
    "test:chartable": "node test/side-char-table.mjs",
    "test:ct-gate": "node test/char-table-gate.mjs",
    "test:itrans": "node test/itrans-corpus.mjs",
    "test:pali-canon": "node test/pali-canon-crossscript.mjs",
    "test:allcorpus": "node test/buddhist-corpus.mjs && node test/all-schemes-corpus.mjs && node test/authoritative-corpus.mjs && node test/classical-corpus.mjs && node test/itrans-corpus.mjs && node test/pali-canon-crossscript.mjs",
    "test:all": "node test/parallel-runner.mjs test/test-pools.json test/build/runner-state.json",
    "test:store": "node test/store-clone.mjs",
    "test:cmap": "node test/font-cmap.mjs",
    "test:translit-run": "node test/translit-run.mjs",
    "test:translit-panel": "node test/translit-panel.mjs",
    "test:translit-ambiguity": "node test/translit-ambiguity.mjs",
    "test:fontname": "node test/font-name.mjs",
    "test:lantsa": "node test/siddham-lantsa-embed.mjs",
    "test:platform": "node scripts/check-platform.mjs",
    "test:gate": "node test/platform-gate.mjs",
    "test:editor-advance": "node test/editor-vertical-advance-browser.mjs",
    "test:native-typo-vars": "node test/native-typo-vars-browser.mjs",
    "test:sanskrit-roundtrip": "node test/sanskrit-roundtrip.mjs",
    "test:translit-cross-reference": "node test/sanskrit-cross-reference.mjs",
    "test:pools": "node test/parallel-runner.mjs test/test-pools.json test/build/runner-state.json",
    "test:fast": "node test/parallel-runner.mjs test/test-pools-fast.json test/build/runner-state-fast.json",
    "test:browser": "node test/parallel-runner.mjs test/test-pools-browser.json test/build/runner-state-browser.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vertical-writing",
    "tategaki",
    "mongolian",
    "manchu",
    "old-uyghur",
    "epub",
    "pdf"
  ],
  "author": "quasicry",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.25.12",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.5.1",
    "linkedom": "0.18.14",
    "obsidian": "1.14.4",
    "pagedjs": "0.4.3",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasicry/lilium.git"
  },
  "homepage": "https://github.com/quasicry/lilium#readme",
  "bugs": {
    "url": "https://github.com/quasicry/lilium/issues"
  }
}
